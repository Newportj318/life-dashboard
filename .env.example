# Copy to .env.local and fill in. Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hevy → Settings → Developer (needs Hevy Pro)
HEVY_API_KEY=

# strava.com/settings/api → your app
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# PocketSmith → Settings → Security & Integrations → Developer keys
POCKETSMITH_API_KEY=
